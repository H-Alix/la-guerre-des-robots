public class Main
{
    public static void main(String[] args){
        World Monde1 = new World(-10, 10, -10, 10);
        Robolix Robot1 = Robolix.CreateRobolix("Devastator", "1.12", Monde1, 10, DamageTypes.MAGIQUE);
        Robot Robot2 = Robot.CreateRobot("STOMPA", "117", Monde1, 10, DamageTypes.PHYSIQUE);

  

        Monde1.LaunchWar();
        for (int i = 0; i < 10; i++) {
            Robot1.ActionMvt(Monde1);
            Robot2.ActionMvt(Monde1);
        }
    }
}
