public class World {
    private final int minX;
    private final int maxX;
    private final int minY;
    private final int maxY;
    private String wName;

    public World(int minX, int maxX, int minY, int maxY, String p_name) {
        this.minX = minX;
        this.maxX = maxX;
        this.minY = minY;
        this.maxY = maxY;
        this.wName = p_name;
    }
   
    public int getMinX() {
        return minX;
    }
    public int getMaxX() {
        return maxX;
    }
    public int getMinY() {
        return minY;
    }
    public int getMaxY() {
        return maxY;
    }

}

