public class RobotDady extends Robot{
    private static String CreatorName = "Dady";


    public RobotDady(String p_name, String p_version, World p_world, int p_HP, DamageTypes p_dmg){
        super(p_name, p_version, p_world, p_HP, p_dmg);
        this.mvtX = 4;
        this.mvtY = -2;
    }

    

    public static RobotDady createRobotDady(String p_name, String p_version, World p_world, int p_HP, DamageTypes p_dmg) {
    if (p_name == null || p_name.length() < 5) {
        System.out.println("Nom trop court");
        return null;
    } else {
        return new RobotDady(p_name, p_version, p_world, p_HP, p_dmg);
    }
    }

}
